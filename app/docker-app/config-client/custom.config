# Server address overrides.
#
# The client stack connects to the server only through the server's exposed host
# ports: RabbitMQ on 5672 and the storage API on 8001.
#
# Default (same machine): host.docker.internal resolves to the Docker host from
# inside client containers.  On Linux this is provided by the extra_hosts entry
# in docker-compose.client.yml; on macOS/Windows Docker Desktop it is built in.
#
# Production (different machines): replace host.docker.internal with the server
# machine's IP address or hostname.  Ensure TCP 5672 and 8001 are reachable from
# the client machine (check firewall rules on the server side).
#
# Example:
#   server: amqp://eliza:eliza123@192.168.1.100:5672/
#   storage_url: http://192.168.1.100:8001/storage

[cltl.event.kombu]
server: amqp://eliza:eliza123@host.docker.internal:5672/

[cltl.backend.remote_storage]
storage_url: http://host.docker.internal:8001/storage
