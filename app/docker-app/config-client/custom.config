# Server address overrides.
#
# For local single-machine testing: the server stack exposes RabbitMQ on 5672
# and the storage service on 8001. Use host.docker.internal to reach them from
# inside the client containers.
#
# For a real remote server: replace host.docker.internal with the server's IP.

[cltl.event.kombu]
server: amqp://eliza:eliza123@host.docker.internal:5672/

[cltl.backend.remote_storage]
storage_url: http://host.docker.internal:8001/storage
