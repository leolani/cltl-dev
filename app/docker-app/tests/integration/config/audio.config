# Audio test overrides — layered on top of custom.config for the audio pipeline tests.
# Enables the mic thread, VAD, and ASR; points the backend to the stub audio server
# running on the host at port 9000.

[cltl.backend]
run_server: False
server_audio_url: http://host.docker.internal:9876

[cltl.backend.mic]
topic: cltl.topic.microphone

[cltl.asr]
implementation: whisper
sampling_rate: 16000
vad_topic: cltl.topic.vad
asr_topic: cltl.topic.text_in
