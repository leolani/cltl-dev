# Test-specific overrides for the client container in audio tests.
# Enables the mic thread pointed at the stub audio server on the host,
# while keeping run_server disabled (no physical device access in Docker).

[cltl.backend]
run_server: False
storage_url: http://host.docker.internal:8001/storage
server_audio_url: http://host.docker.internal:9876

[cltl.backend.mic]
topic: cltl.topic.microphone

[cltl.backend.image]
topic:
rate: 0

[cltl.backend.remote_storage]
storage_url: http://host.docker.internal:8001/storage

[cltl.event.kombu]
server: amqp://eliza:eliza123@host.docker.internal:5672/

[cltl.keyword]
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out

[cltl.context]
topic_scenario: cltl.topic.scenario
topic_speaker: cltl.topic.scenario_speaker
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_knowledge:
start_scenario: true