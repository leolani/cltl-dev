# Test-specific overrides. Values here take precedence over default.config.
# Add only the settings that need to differ from the production defaults.

[cltl.backend.mic]
# Empty topic disables the microphone thread in BackendService._start_mic.
topic:

[cltl.backend.image]
# rate: 0 disables the image capture thread in BackendService._start_image.
topic:
rate: 0

[cltl.asr]
# Empty implementation disables ASR entirely (prevents loading Whisper on startup).
implementation:
sampling_rate: 16000
vad_topic: cltl.topic.vad
asr_topic: cltl.topic.text_in
