[loggers]
keys: root, amqp_connection, werkzeug

[handlers]
keys: console, file

[formatters]
keys: pepperFormatter

[logger_root]
level: DEBUG
handlers: console, file

[handler_console]
class: StreamHandler
level: NOTSET
formatter: pepperFormatter
args: (sys.stdout,)

[handler_file]
class: FileHandler
level: DEBUG
formatter: pepperFormatter
args: ('storage/test.log', 'a')

[formatter_pepperFormatter]
format: %(asctime)s %(levelname)-8s %(name)-60s %(message)s
datefmt: %x %X

[logger_amqp_connection]
level: INFO
handlers: console, file
qualname: amqp.connection
propagate: 0

[logger_werkzeug]
level: WARNING
handlers: console, file
qualname: werkzeug
propagate: 0
