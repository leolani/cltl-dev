# Test-specific overrides for the client container.
# Disables hardware device access (no microphone, camera, or server) so the
# client backend can start in a Docker environment without physical devices.
# Also carries forward the host-side URLs from config-client/custom.config,
# which this file shadows when mounted into the container.

[cltl.backend]
run_server: False
storage_url: http://host.docker.internal:8001/storage

[cltl.backend.mic]
topic:

[cltl.backend.image]
topic:
rate: 0

[cltl.backend.remote_storage]
storage_url: http://host.docker.internal:8001/storage

[cltl.event.kombu]
server: amqp://eliza:eliza123@host.docker.internal:5672/

[cltl.keyword]
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out

[cltl.context]
topic_scenario: cltl.topic.scenario
topic_speaker: cltl.topic.scenario_speaker
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_knowledge:
start_scenario: true