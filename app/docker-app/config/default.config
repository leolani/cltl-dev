[cltl.audio]
sampling_rate: 16000
channels: 1
sample_depth: 2
frame_size: 480

audio_resource: cltl.backend.resource.audio
mic_resource: cltl.backend.resource.microphone

[cltl.video]
resolution: VGA
camera_index: 0

[cltl.backend]
run_server: False
server_image_url: http://host.docker.internal:8000
server_audio_url: http://host.docker.internal:8000
storage_url: http://eliza-backend:8000/storage/
audio_storage: local
audio_storage_path: ./storage/audio
audio_source_buffer: 16
image_storage: local
image_storage_path: ./storage/image
image_cache: 32
scenario_topic: cltl.topic.scenario

[cltl.backend.remote_storage]
storage_url: http://eliza-backend:8000/storage
upload_timeout: 30

[cltl.backend.mic]
topic:

[cltl.backend.image]
topic:
rate: 0

[cltl.backend.tts]
topic: cltl.topic.text_out

[cltl.backend.text_output]
## remote_type: tts     → send text to {remote_url}/text (AnimatedRemoteTextOutput)
## remote_type: sound   → synthesise locally via gTTS, POST WAV to {remote_url}/sound
## remote_type: console → print to stdout (ignores remote_url, for development)
## Default (no remote_url): local gTTS playback via playsound
remote_url:
remote_type: tts
## Example for robot: remote_url: http://robot.local:7342
##                    remote_type: sound

[cltl.vad]
implementation:
mic_topic: cltl.topic.microphone
vad_topic: cltl.topic.vad

[cltl.vad.webrtc]
activity_window: 300
activity_threshold: 0.8
allow_gap: 300
padding: 600

[cltl.asr]
implementation: whisper
sampling_rate: 16000
vad_topic: cltl.topic.vad
asr_topic: cltl.topic.text_in

[cltl.asr.google]
sampling_rate: 16000
language: en-GB
hints:

[cltl.asr.whisper]
model: base
language: en

[cltl.asr.wav2vec]
# model: facebook/wav2vec2-large-960h
model: jonatasgrosman/wav2vec2-large-xlsr-53-english

[cltl.asr.speechbrain]
# model: speechbrain/asr-transformer-transformerlm-librispeech
model: speechbrain/asr-wav2vec2-commonvoice-en

[cltl.chat-ui]
name: chat-ui
agent_id: leolani
external_input: True
timeout: 0
# In step with app/py-app/config/default.config. The chat UI's image submit is
# this deployment's only producer of ImageSignals — [cltl.backend.image] has no
# topic and there is no camera — so without these two keys the Monitoring tab
# has nothing to show, ever.
image_upload: True
image_cache: 4
image_max_size: 10485760
image_types: image/png, image/jpeg, image/gif, image/webp
# Empty falls back to [cltl.backend] storage_url, which is what resolves the
# same `cltl-storage:` reference on the reading side.
image_storage_url:
image_upload_timeout: 30
# Where the *browser* reaches cltl-monitoring, so a published host port and not
# the service name: http://eliza-monitoring:8000 resolves on the compose network
# and nowhere else. The same trap as storage_url, in the opposite direction.
monitoring_url: http://localhost:8004/monitoring

[cltl.chat-ui.events]
local: True
topic_utterance: cltl.topic.text_in
topic_response: cltl.topic.text_out
topic_scenario : cltl.topic.scenario
topic_image: cltl.topic.image

[cltl.monitoring]
topic_scenario: cltl.topic.scenario
topic_image: cltl.topic.image
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
# No object or face recognition in this deployment. Empty means the topic is not
# subscribed at all.
topic_object:
topic_vector_id:
# Record always: images arrive one at a time from the chat UI, and one submitted
# while a non-zero interval had lapsed would be dropped with no replay.
active_interval: 0
scenario_cache: 4

[cltl.eliza]
language: en
topic_input : cltl.topic.text_in
topic_output : cltl.topic.text_out
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire

[cltl.keyword]
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in : cltl.topic.text_in
topic_text_out : cltl.topic.text_out

[cltl.intentions.init]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
topic_face:
greeting: Do you want to talk to me?

[cltl.bdi]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
model: {"init":
             {"initialized": ["eliza"]},
         "eliza":
             {"quit": ["init"]}
         }

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: amqp://eliza:eliza123@rabbitmq:5672/
exchange: cltl.combot
compression: bzip2
tenant: local

[cltl.emissor-data]
path: ./storage/emissor

[cltl.emissor-data.event]
topics: cltl.topic.scenario,
        cltl.topic.image, cltl.topic.microphone,
        cltl.topic.text_in, cltl.topic.text_out,
        cltl.topic.vad,
        cltl.desire, cltl.intention

[cltl.event_log]
log_dir: ./storage/event_log

[cltl.context]
topic_scenario: cltl.topic.scenario
topic_speaker: cltl.topic.scenario_speaker
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_knowledge:
start_scenario: true

[environment]
GOOGLE_APPLICATION_CREDENTIALS: config/google_cloud_key.json
