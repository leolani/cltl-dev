[cltl.audio]
sampling_rate: 16000
channels: 1
sample_depth: 2
frame_size: 480

audio_resource: cltl.backend.resource.audio
mic_resource: cltl.backend.resource.microphone

[cltl.video]
resolution: VGA
camera_index: 0

[cltl.backend]
### To run locally with system
run_server: False
server_image_url: http://0.0.0.0:8000/host
server_audio_url: http://0.0.0.0:8000/host
### To run on pepper
# run_server: False
# server_image_url: http://192.168.1.176:8000
# server_audio_url: http://192.168.1.176:8000
storage_url: http://0.0.0.0:8000/storage/
audio_storage: local
audio_storage_path: ./storage/audio
audio_source_buffer: 16
image_storage: local
image_storage_path: ./storage/image
image_cache: 32
scenario_topic: cltl.topic.scenario

[cltl.backend.remote_storage]
# Used when cltl.backend.audio_storage = remote
storage_url: http://localhost:8000/storage
upload_timeout: 30

[cltl.backend.mic]
topic:

[cltl.backend.image]
topic:
rate: 0

[cltl.backend.tts]
topic: cltl.topic.text_out

[cltl.backend.text_output]
## remote_type: tts     → send text to {remote_url}/text (AnimatedRemoteTextOutput)
## remote_type: sound   → synthesise locally via gTTS, POST WAV to {remote_url}/sound
## remote_type: console → print to stdout (ignores remote_url, for development)
## Default (no remote_url): local gTTS playback via playsound
remote_url:
remote_type: tts
## Example for robot: remote_url: http://192.168.1.176:7342
##                    remote_type: sound

[cltl.vad]
implementation:
mic_topic: cltl.topic.microphone
vad_topic: cltl.topic.vad

[cltl.vad.webrtc]
activity_window: 300
activity_threshold: 0.8
allow_gap: 300
padding: 600

[cltl.asr]
implementation:
sampling_rate: 16000
vad_topic: cltl.topic.vad
asr_topic: cltl.topic.text_in

[cltl.asr.google]
sampling_rate: 16000
language: en-GB
hints:

[cltl.asr.whisper]
model: base
language: en

[cltl.asr.wav2vec]
# model: facebook/wav2vec2-large-960h
model: jonatasgrosman/wav2vec2-large-xlsr-53-english

[cltl.asr.speechbrain]
# model: speechbrain/asr-transformer-transformerlm-librispeech
model: speechbrain/asr-wav2vec2-commonvoice-en

[cltl.chat-ui]
name: chat-ui
agent_id: leolani
external_input: True
timeout: 0
# Upload an image beside the chat, mark regions on it and submit. The regions
# are recorded as EMISSOR mentions on an ImageSignal; nothing is published on
# topic_utterance, so the agent does not answer an image as if it were a
# question.
image_upload: True
# Uploads held in memory to render the transcript: count x bytes.
image_cache: 4
image_max_size: 10485760
image_types: image/png, image/jpeg, image/gif, image/webp
# Where the pixels are PUT so that `cltl-storage:image/<id>` resolves for
# cltl-emissor-data. Empty falls back to [cltl.backend] storage_url, which is
# what resolves the same reference on the reading side — keep them in step.
image_storage_url:
image_upload_timeout: 30

[cltl.chat-ui.events]
local: True
topic_utterance: cltl.topic.text_in
topic_response: cltl.topic.text_out
topic_scenario : cltl.topic.scenario
# Already in [cltl.emissor-data.event] topics, so the annotated signal is
# persisted without any further wiring.
topic_image: cltl.topic.image

[cltl.eliza]
language: en
topic_input : cltl.topic.text_in
topic_output : cltl.topic.text_out
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire

[cltl.keyword]
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in : cltl.topic.text_in
topic_text_out : cltl.topic.text_out

[cltl.intentions.init]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
topic_face:
greeting: Do you want to talk to me?

[cltl.bdi]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
model: {"init":
             {"initialized": ["eliza"]},
         "eliza":
             {"quit": ["init"]}
         }

[cltl.event]
implementation: internal

[cltl.event.kombu]
# For local development with Docker Compose
# server: amqp://eliza:eliza123@rabbitmq:5672/
# For local development without Docker (uncomment below and comment above)
server: amqp://eliza:eliza123@localhost:5672/
exchange: cltl.combot
compression: bzip2
tenant: local

[cltl.emissor-data]
path: ./storage/emissor
# Write signals to disk as they arrive. The default is -1, which keeps them in
# memory and writes only on a clean scenario stop — so an interrupted run loses
# the whole conversation, including any annotated image submitted during it.
flush_interval: 0

[cltl.emissor-data.event]
topics: cltl.topic.scenario,
        cltl.topic.image, cltl.topic.microphone,
        cltl.topic.text_in, cltl.topic.text_out,
        cltl.topic.vad,
        cltl.desire, cltl.intention

[cltl.event_log]
log_dir: ./storage/event_log

[eliza.context]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire

[environment]
GOOGLE_APPLICATION_CREDENTIALS: config/google_cloud_key.json
