# Tier 1 (InProcessRunner) overrides.
#
# These are the only settings that differ between the two runners. Values are
# supplied through $VAR interpolation rather than templating: ConfigParser is
# built with EnvInterpolation, which expands $VAR/${VAR} from os.environ when a
# value is read. InProcessRunner sets CLTL_HTTP_BASE and CLTL_STORAGE_DIR before
# loading the configuration.

[cltl.event]
implementation: internal

[cltl.backend]
storage_url: $CLTL_HTTP_BASE/storage/
# The microphone stream. Empty unless a test points it at a StubAudioServer;
# InProcessRunner always defines the variable so that EnvInterpolation has
# nothing to warn about. ClientAudioSource appends "/audio" to it.
server_audio_url: $CLTL_AUDIO_URL
# The camera endpoint, on the same terms as the microphone above. Empty
# unless a test points it at a StubImageServer; ClientImageSource appends
# "/image" to it.
server_image_url: $CLTL_IMAGE_URL
audio_storage_path: $CLTL_STORAGE_DIR/audio
image_storage_path: $CLTL_STORAGE_DIR/image

[cltl.backend.text_output]
# Where the agent's replies are spoken. Empty unless a test points it at a
# StubTextOutput, and defined either way for the same reason as the microphone
# above. Only consulted when [cltl.backend.tts] topic is set; AnimatedRemote-
# TextOutput appends "/text" to it.
remote_url: $CLTL_TTS_URL

[cltl.backend.remote_storage]
storage_url: $CLTL_HTTP_BASE/storage

[cltl.emissor-data]
path: $CLTL_STORAGE_DIR/emissor

[cltl.event_log]
log_dir: $CLTL_STORAGE_DIR/event_log

[cltl.chat-ui]
# Where the browser reaches cltl-monitoring, for the Monitoring tab. Root-
# relative in this tier: every module is mounted under one DispatcherMiddleware
# on one port, so the page can ask for /monitoring on its own origin.
# InProcessRunner sets this to the empty string when the topology has no
# monitoring module, which leaves the tab out.
monitoring_url: $CLTL_MONITORING_URL
