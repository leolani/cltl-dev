# Tier 1 (InProcessRunner) overrides.
#
# These are the only settings that differ between the two runners. Values are
# supplied through $VAR interpolation rather than templating: ConfigParser is
# built with EnvInterpolation, which expands $VAR/${VAR} from os.environ when a
# value is read. InProcessRunner sets CLTL_HTTP_BASE and CLTL_STORAGE_DIR before
# loading the configuration.

[cltl.event]
implementation: internal

[cltl.backend]
storage_url: $CLTL_HTTP_BASE/storage/
# The microphone stream. Empty unless a test points it at a StubAudioServer;
# InProcessRunner always defines the variable so that EnvInterpolation has
# nothing to warn about. ClientAudioSource appends "/audio" to it.
server_audio_url: $CLTL_AUDIO_URL
audio_storage_path: $CLTL_STORAGE_DIR/audio
image_storage_path: $CLTL_STORAGE_DIR/image

[cltl.backend.remote_storage]
storage_url: $CLTL_HTTP_BASE/storage

[cltl.emissor-data]
path: $CLTL_STORAGE_DIR/emissor

[cltl.event_log]
log_dir: $CLTL_STORAGE_DIR/event_log
