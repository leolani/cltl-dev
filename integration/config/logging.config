# Logging for the containerised modules (tier 2).
#
# Every image's src/main.py does
#   logging.config.fileConfig(os.environ.get('CLTL_LOGGING_CONFIG', 'config/logging.config'))
# and fileConfig raises if the file is missing, so a container without this
# never reaches its first line of application code. The compose file points
# CLTL_LOGGING_CONFIG at this file inside each image's mounted config directory.
#
# Root is INFO, not DEBUG: at DEBUG the event bus logs a line per AMQP frame and
# `docker compose logs` becomes unreadable in the one place it matters, a failed
# tier-2 run.

[loggers]
keys: root, amqp_connection, werkzeug, config_local

[handlers]
keys: console

[formatters]
keys: cltlFormatter

[logger_root]
level: INFO
handlers: console

[handler_console]
class: StreamHandler
level: NOTSET
formatter: cltlFormatter
args: (sys.stdout,)

[formatter_cltlFormatter]
format: %(asctime)s %(levelname)-8s %(name)-50s %(message)s
datefmt: %x %X

[logger_amqp_connection]
level: INFO
handlers: console
qualname: amqp.connection
propagate: 0

[logger_werkzeug]
level: WARNING
handlers: console
qualname: werkzeug
propagate: 0

# Dumps the entire merged configuration at INFO on every load. With eight
# containers that is most of `docker compose logs`, which is the only account of
# a tier-2 failure there is.
[logger_config_local]
level: WARNING
handlers: console
qualname: cltl.combot.infra.config.local
propagate: 0
