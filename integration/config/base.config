# Tier-neutral baseline for the integration harness.
#
# Derived from app/py-app/config/default.config, with three deliberate changes:
#
#  1. Every module implementation is DISABLED here. A topology overlay enables
#     exactly what it needs, so a test can never be silently influenced by a
#     module it did not ask for.
#  2. Nothing tier-specific appears here — no event-bus implementation, no URLs,
#     no storage paths. Those live in tier-inprocess.config / tier-compose.config
#     and are the only values that differ between the two runners.
#  3. Intention gating is off by default (`intentions:` empty). Services gated on
#     an intention stay inactive until a BDI service publishes it, which would
#     make every slice test that omits cltl-context silently pass zero events.
#     Topologies that include the BDI loop switch gating back on.
#
# The canonical cltl.topic.* names live here. Note that each submodule ships its
# own config/default.config using LEGACY names (cltl.mic, cltl.chat.utterance);
# those are for standalone `python src/main.py` runs only and must never be used
# by the harness.

[cltl.audio]
sampling_rate: 16000
channels: 1
sample_depth: 2
frame_size: 480
audio_resource: cltl.backend.resource.audio
mic_resource: cltl.backend.resource.microphone

[cltl.video]
resolution: VGA
camera_index: 0

[cltl.backend]
run_server: False
server_image_url:
server_audio_url:
audio_storage: local
audio_source_buffer: 16
image_storage: local
image_cache: 32
scenario_topic: cltl.topic.scenario

[cltl.backend.remote_storage]
upload_timeout: 30

[cltl.backend.mic]
topic:

[cltl.backend.image]
topic:
rate: 0

[cltl.backend.tts]
# Empty by design. With a topic set, BackendService routes text_out to
# SynchronizedTextToSpeech.say, which blocks forever on the audio resource
# unless the microphone is also running to provide it. A topology that wants TTS
# must enable the mic too; see cltl_integration.topology.validate_config.
topic:

[cltl.backend.text_output]
remote_url:
remote_type: console

[cltl.vad]
implementation:
mic_topic: cltl.topic.microphone
vad_topic: cltl.topic.vad

[cltl.vad.webrtc]
activity_window: 300
activity_threshold: 0.8
allow_gap: 300
padding: 600

[cltl.asr]
implementation:
sampling_rate: 16000
vad_topic: cltl.topic.vad
asr_topic: cltl.topic.text_in

[cltl.asr.whisper]
model: base
language: en

[cltl.asr.google]
sampling_rate: 16000
language: en-GB
hints:

[cltl.chat-ui]
name: chat-ui
agent_id: leolani
external_input: True
timeout: 0
# Off here like every other implementation; config/topologies/chatui_image.config
# switches it on. image_storage_url is deliberately left empty so that the
# fallback to [cltl.backend] storage_url applies: the chat UI then PUTs pixels
# to the same endpoint cltl-emissor-data reads `cltl-storage:` back from, in
# both tiers, with one value to keep right instead of two.
image_upload: False
image_cache: 4
image_max_size: 10485760
image_types: image/png, image/jpeg, image/gif, image/webp
image_storage_url:
image_upload_timeout: 30

[cltl.chat-ui.events]
local: True
topic_utterance: cltl.topic.text_in
topic_response: cltl.topic.text_out
topic_scenario: cltl.topic.scenario
topic_image:

[cltl.eliza]
language: en
topic_input: cltl.topic.text_in
topic_output: cltl.topic.text_out
intentions:
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire

[cltl.keyword]
intentions:
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out

[cltl.intentions.init]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
topic_face:
greeting: Do you want to talk to me?

[cltl.bdi]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
model: {"init": {"initialized": ["eliza"]}, "eliza": {"quit": ["init"]}}

[cltl.context]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_speaker:
topic_knowledge:

[cltl.emissor-data.event]
topics: cltl.topic.scenario,
        cltl.topic.image, cltl.topic.microphone,
        cltl.topic.text_in, cltl.topic.text_out,
        cltl.topic.vad
