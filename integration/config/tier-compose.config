# Tier 2 (ComposeRunner) overrides.
#
# The same $VAR indirection as tier 1, for a different reason. Here the *same*
# file is read by two kinds of process with different views of the network: the
# containers reach RabbitMQ at `rabbitmq:5672` and the backend at `backend:8000`
# on the compose network, while the test process reaches both through ephemeral
# published ports on 127.0.0.1. Compose sets these variables one way in the
# services' environment, ComposeRunner sets them the other way in its own, and
# neither needs a second copy of the configuration.
#
# ComposeRunner merges this file with the topology overlay into a single
# `custom.config`, because the platform's config loader takes a fixed
# two-element list of additional files and this is the only slot available.

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: $CLTL_AMQP_URL
exchange: cltl.combot
compression: bzip2

[cltl.backend]
# Trailing slash is load-bearing: CltlAudioAdapter resolves cltl-storage: URLs
# with urljoin(storage_url, "audio/<id>"), which drops the last path segment
# when the base does not end in one.
storage_url: $CLTL_STORAGE_URL
server_audio_url: $CLTL_AUDIO_URL
# Relative to each image's WORKDIR, where the run's storage directory is mounted.
audio_storage_path: ./storage/audio
image_storage_path: ./storage/image

[cltl.backend.remote_storage]
storage_url: $CLTL_STORAGE_URL

[cltl.emissor-data]
path: ./storage/emissor

[cltl.event_log]
log_dir: ./storage/event_log

[cltl.context]
# The container's main.py publishes the init intention itself when this is true.
# Off by default so the test process can drive the handshake and observe it from
# the first event, exactly as it does in tier 1. One test turns it on, to check
# that a deployment with no test process attached still bootstraps itself.
start_scenario: false
