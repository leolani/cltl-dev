# Topology: chatui_image — a person uploads an image, marks regions, submits.
#
# Three modules, and each is here for a reason the others cannot cover:
#
#   chatui   the thing under test: the upload endpoint, the annotation endpoint
#            and the echo in the transcript.
#   emissor  the only witness to whether the annotations survived. cltl-chat-ui
#            publishes and forgets; what matters is the scenario on disk.
#   backend  the image storage the chat UI PUTs pixels to. Without it the
#            signal's `cltl-storage:image/<id>` reference resolves to nothing
#            and the PNG never reaches the scenario folder — which is exactly
#            the failure the test has to be able to tell apart from "the
#            annotations were lost".
#
# cltl-eliza is deliberately absent, but its absence is not what makes the test
# meaningful: the point is that submitting publishes nothing on
# cltl.topic.text_in at all, which the test asserts directly.

[cltl.chat-ui]
image_upload: True

[cltl.chat-ui.events]
topic_image: cltl.topic.image

# The default is -1, which never writes signals to disk: scenario.json appears
# but image.json stays empty, and a test asserting on files sees nothing.
[cltl.emissor-data]
flush_interval: 0
