# Topology: backend_tts_mic — the agent speaks while the microphone is open.
#
# backend_tts with the recording thread running, which is the case
# SynchronizedTextToSpeech and SynchronizedMicrophone exist to arbitrate. The
# microphone holds a *read* lock on the audio resource for the whole of
# `listen()`; `say` takes the *write* lock. So the mic has to notice the waiting
# speaker, mute itself and release, then take the lock back afterwards — the
# protocol written out in SynchronizedMicrophone.listen's docstring.
#
# Nothing else in the suite runs both halves at once, so nothing else can tell
# whether that protocol still works.

[cltl.backend.tts]
topic: cltl.topic.text_out

[cltl.backend.text_output]
remote_type: remote

[cltl.backend.mic]
topic: cltl.topic.microphone
