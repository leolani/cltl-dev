# Topology: chat_full — the whole chat UI, with both side panels switched on.
#
# text_pipeline plus cltl-monitoring and the image storage it reads through. It
# exists because no other topology puts a person, a conversation and both panels
# in the same place:
#
#   chatui      the conversation, the image annotator and the Monitoring tab.
#   context     the BDI loop that opens the scenario. The Monitoring tab is
#               keyed by scenario_id and shows nothing without one, and the
#               annotator's echo needs a scenario to be posted into.
#   eliza       something to talk to while watching what it perceived.
#   monitoring  the per-scenario view the tab embeds in an iframe.
#   backend     the image storage. The chat UI PUTs the pixels there and
#               publishes a `cltl-storage:image/<id>` reference; monitoring
#               resolves that reference back over HTTP. Without it the tab
#               renders nothing and the log says only "Could not load image".
#
# Demo-only: there is no tests/ file for this topology. What each panel does on
# its own is asserted by tests/slices/test_chatui_image.py and
# tests/slices/test_chatui_monitoring.py, neither of which opens a browser. This
# is the one a person drives by hand, so it is also the only place the tab strip
# itself — which panel is offered, and whether the column appears at all — is
# ever actually looked at.
#
# `monitoring_url` is deliberately absent: it is the URL the browser uses, so it
# differs per tier and per run, and each runner interpolates it into
# config/tier-*.config from $CLTL_MONITORING_URL.

# Intention gating, exactly as text_pipeline: ElizaService stays inactive until
# the init handshake completes and BDIService publishes the `eliza` intention.
[cltl.eliza]
intentions: eliza

[cltl.chat-ui]
image_upload: True

[cltl.chat-ui.events]
topic_image: cltl.topic.image

[cltl.monitoring]
topic_image: cltl.topic.image
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
