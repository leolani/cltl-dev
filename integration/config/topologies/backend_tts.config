# Topology: backend_tts — the agent's reply, spoken.
#
# The one leg of the platform nothing else in the suite runs. BackendService
# subscribes its TTS worker to [cltl.backend.tts] topic and hands every payload
# to SynchronizedTextToSpeech.say, which takes a write lock on the audio
# resource and then calls the configured TextOutput.
#
# remote_type is deliberately neither "console" nor "sound": BackendContainer's
# text_output falls through to AnimatedRemoteTextOutput, which POSTs the reply to
# $CLTL_TTS_URL/text. So this needs no sound device, in this process or in an
# image — which is why "the machine has no speakers" was never a reason to leave
# this untested.
#
# It matters because SynchronizedTextToSpeech.say wraps its whole body in a bare
# `except:` that only logs (cltl-backend/src/cltl/backend/impl/sync_tts.py:70).
# A backend that fails to speak fails silently: the reply is still on the bus,
# still in the chat UI, and simply never comes out of the robot.

[cltl.backend.tts]
topic: cltl.topic.text_out

[cltl.backend.text_output]
remote_type: remote
