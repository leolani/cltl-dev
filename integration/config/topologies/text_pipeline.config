# Topology: text_pipeline — chat UI -> context/BDI -> eliza -> chat UI.
#
# The one topology that runs with intention gating ON, because it is the only
# one with a BDI service to switch the intentions. ElizaService stays inactive
# until the init handshake completes and BDIService publishes the `eliza`
# intention; that ordering is the point of the test.
#
# [cltl.keyword] intentions is inherited from base.config as `eliza`, so the
# goodbye keyword is live exactly while Eliza is conversing and inert during the
# init handshake. See tests/slices/test_context_bdi.py::TestKeywordQuit.

[cltl.eliza]
intentions: eliza

[cltl.chat-ui]
# Sent by the chat UI's stop button as the user's own utterance, so it has to be
# one of [cltl.keyword] keywords (unset there, so GOODBYE).
stop_phrase: Bye
