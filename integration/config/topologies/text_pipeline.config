# Topology: text_pipeline — chat UI -> context/BDI -> eliza -> chat UI.
#
# The one topology that runs with intention gating ON, because it is the only
# one with a BDI service to switch the intentions. ElizaService stays inactive
# until the init handshake completes and BDIService publishes the `eliza`
# intention; that ordering is the point of the test.
#
# [cltl.keyword] intentions is deliberately left empty. KeywordService.start()
# hardcodes intentions=["chat"] and its from_config never reads the setting, so
# a value here would document an effect that does not exist. See
# tests/slices/test_context_bdi.py::TestKeywordQuit.

[cltl.eliza]
intentions: eliza
