# Topology: spoken_pipeline — audio_pipeline plus the BDI handshake.
#
# The shape a robot actually runs: a person speaks, cltl-context asks whether
# they want to talk, and they answer out loud. Everything audio_pipeline covers,
# with the one thing it leaves out — intention gating — switched on.
#
# That gating is the point. ElizaService stays inactive until BDIService
# publishes the `eliza` intention, and BDIService only does that once
# InitService has seen an affirmative on cltl.topic.text_in. In every other test
# that affirmative is typed into the chat UI; here it is transcribed by Whisper,
# so what InitService matches against is a real recogniser's output —
# capitalised, punctuated, and occasionally not what was said at all.
#
# TTS stays off. The reply-spoken leg has its own topologies (backend_tts,
# backend_tts_mic) that cost seconds rather than minutes.

[cltl.backend.mic]
topic: cltl.topic.microphone

[cltl.asr]
implementation: whisper

[cltl.eliza]
intentions: eliza
