# Topology: multitenant_tenant — one tenant deployment, run once per tenant id.
#
# Three modules, each carrying something the others cannot:
#
#   context   creates the scenario. It is what makes a tenant a tenant rather
#             than a second copy of a client: the scenario is opened inside the
#             tenant, by that tenant's BDI loop, and every event descending from
#             it carries the tenant on its metadata.
#   chatui    creates the text signal and shows the reply — the near end of the
#             round trip, and the one a person would touch.
#   emissor   the *different* module that picks the reply up inside the tenant.
#             Each tenant stack has its own storage root, so "did tenant B see
#             tenant A's reply" is answerable from the filesystem and not only
#             from the bus.
#
# This one file is deployed identically to every tenant. The only difference
# between two tenants is CLTL_TENANT in the container environment, which
# EnvInterpolation expands into `[cltl.event.kombu] tenant` below when the value
# is read rather than when the file is parsed — see
# cltl.combot.infra.config.local. Configuration is written once per stack and is
# byte-identical; the tenant arrives from the outside.
#
# cltl-eliza is deliberately absent: it is the shared module, on the server. See
# config/topologies/multitenant_server.config for why it has to run ungated, and
# why that is a property of the *server* rather than of eliza. The gating that
# does apply here — InitService's `init`, KeywordService's `chat` — is per
# container and therefore already per tenant.
#
# [cltl.context] start_scenario stays false (from tier-compose.config): the test
# process publishes the init intention on the tenant's own bus, and that a
# tenanted publish reaches the tenant's context at all is part of what is tested.

[cltl.event.kombu]
tenant: $CLTL_TENANT

[cltl.emissor-data]
# Write after every event, so a test can assert on the files rather than on a
# flush that may not have happened yet. See config/topologies/emissor.config.
flush_interval: 0
