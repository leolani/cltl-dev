# Topology: chatui_display — the Display tab beside the chat window.
#
# One module. The chat UI is the consumer and the test is the publisher: no
# module asks for a page to be shown yet, and a topology that pulled one in would
# be testing that module's choice of page rather than the tab.
#
# The Image tab is switched on so that Display is not the only tab: with a single
# panel the strip is left out, and the tab could be neither clicked nor badged.
# Uploads are not exercised here, so there is no backend to store them in.

[cltl.chat-ui]
image_upload: True

[cltl.chat-ui.events]
topic_display: cltl.topic.display
