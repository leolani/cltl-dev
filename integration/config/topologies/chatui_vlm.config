# Topology: chatui_vlm — an uploaded image is recognised by the VLM module.
#
# Three modules, each carrying what the others cannot:
#
#   chatui   turns a human gesture into an ImageSignal. It is the only producer
#            of one that needs no camera and no model.
#   backend  the image storage the chat UI PUTs pixels to. The signal carries only
#            a `cltl-storage:image/<id>` reference, which vlm resolves back over
#            HTTP; without it vlm receives the signal and can fetch nothing.
#   vlm      the subject. Its llama-server is a StubLlamaServer in the test
#            process, reached through $CLTL_VLM_URL (see InProcessRunner's
#            TIER_ENVIRONMENT_DEFAULTS).
#
# cltl-emissor-data is absent on purpose: what is persisted is not this slice's
# subject. The annotations are asserted on the bus.

[cltl.chat-ui]
image_upload: True

[cltl.chat-ui.events]
topic_image: cltl.topic.image

[cltl.vlm_object_recognition]
model: stub-vlm
host: $CLTL_VLM_URL

[cltl.vlm_object_recognition.events]
image_topic: cltl.topic.image
object_topic: cltl.topic.object_recognition
