# Topology: vad_asr — a voice-activity segment turned into a transcript.
#
# cltl-backend is present for its storage service only: the contract between
# cltl-vad and cltl-asr is a VadMentionEvent naming an audio range, which ASR
# resolves to `cltl-storage:audio/<id>` and fetches over HTTP. Without a live
# storage endpoint there is nothing to transcribe.
#
# The mic stays off. This slice drives the VAD event directly, so that the
# assertion is about the vad -> asr boundary and not about whether WebRtcVAD
# found the speech (that is what the backend_vad slice covers).
#
# No ASR implementation is configured: every one of them needs torch or a cloud
# account. The test injects a recogniser through the container override in
# cltl_integration.drivers.asr instead, leaving the real AsrService in place.

[cltl.backend.mic]
topic:
