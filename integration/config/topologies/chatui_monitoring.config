# Topology: chatui_monitoring — what the Monitoring tab shows during a chat.
#
# Three modules, each carrying something the others cannot:
#
#   chatui      the producer. It is the only module in the platform that turns a
#               human gesture into an ImageSignal, and it embeds the regions a
#               person drew inside that signal rather than publishing them
#               separately — so it is also the only thing that exercises
#               monitoring's reading of `signal.mentions`.
#   monitoring  the thing under test.
#   backend     the image storage. The chat UI PUTs the pixels there and
#               publishes a `cltl-storage:image/<id>` reference; monitoring
#               resolves that reference back over HTTP. Without it monitoring
#               receives the signal and can fetch nothing, which is a different
#               failure from "the annotations were lost" and has to be
#               distinguishable from it.
#
# cltl-emissor-data is absent on purpose: what is persisted is
# tests/slices/test_chatui_image.py's subject, not this one's.

[cltl.chat-ui]
image_upload: True

[cltl.chat-ui.events]
topic_image: cltl.topic.image

[cltl.monitoring]
topic_image: cltl.topic.image
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
