# Topology: backend_vad — a microphone stream turned into voice activity.
#
# Enabling the mic topic is what starts BackendService's recording thread. That
# thread does nothing until a ScenarioStarted event arrives (base.config sets
# [cltl.backend] scenario_topic), so the test has to open a scenario; that gate
# is part of what this slice covers.
#
# [cltl.backend] server_audio_url comes from $CLTL_AUDIO_URL, which the test
# points at a StubAudioServer. See config/tier-inprocess.config.
#
# TTS stays disabled. Routing text_out to the backend here would deadlock on the
# audio resource — cltl_integration.topology.validate_config rejects it.

[cltl.backend.mic]
topic: cltl.topic.microphone
