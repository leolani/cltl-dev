# Topology: csplit_server — the far half of the client/server split.
#
# Storage, persistence and the agent. Everything here is stateful or expensive,
# which is the reason to put it on a server in the first place; the client keeps
# only the parts that have to be near the person.
#
# The backend runs src/storage_main.py rather than src/main.py — see the
# `command:` in compose/docker-compose.yml. That is StorageContainer without
# BackendContainer around it: no microphone, no TTS, no camera, just the /storage
# endpoint the client uploads to and cltl-vad and cltl-asr read back from. It is
# the only place in the suite that entry point runs.
#
# [cltl.backend] audio_storage stays `local` (from base.config): the server is
# where "local" means the disk. The client is the one that sets it to `remote`.
#
# Eliza is gated on the `eliza` intention, exactly as in the text_pipeline
# topology, because cltl-context is present — on the other side of the split.
# Nothing about the gating knows that: the intention arrives over the broker
# from a machine that is not this one, which is the point of the test.

[cltl.eliza]
intentions: eliza

[cltl.emissor-data]
# Write after every event, so a test can assert on the files rather than on a
# flush that may not have happened yet. See config/topologies/emissor.config.
flush_interval: 0
