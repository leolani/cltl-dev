# Topology: csplit_client — the near half of the client/server split.
#
# The parts that have to be where the person is: the devices (cltl-backend), the
# conversation's lifecycle (cltl-context) and the interface (cltl-chat-ui).
#
# `remote` storage is what makes this a client. The backend keeps no audio of its
# own; it PUTs every recording to [cltl.backend.remote_storage] storage_url, which
# ComposeRunner points through host.docker.internal at the port the *server*
# project published. Both storage keys read the same $CLTL_STORAGE_URL — see
# config/tier-compose.config — so one variable moves the whole client to another
# machine, which is the deployment this is a rehearsal for.
#
# The microphone stays off here; csplit_audio_client.config turns it on. Without
# it the remote storage is configured but never exercised, so the text split
# drives an HTTP round trip through it explicitly instead.

[cltl.backend]
audio_storage: remote
image_storage: remote

[cltl.backend.mic]
topic:
