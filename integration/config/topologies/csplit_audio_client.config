# Topology: csplit_audio_client — the near half, with a microphone.
#
# csplit_client with the mic topic set, which is what starts BackendService's
# recording thread. The thread does nothing until a ScenarioStarted event
# arrives, and here that event comes from cltl-context in this same stack.
#
# [cltl.backend] server_audio_url comes from $CLTL_AUDIO_URL, pointed at a
# StubAudioServer running in the test process and reached through
# host.docker.internal. So the audio enters on the client, is stored on the
# server, and is transcribed on the server — three network hops that the
# monolithic audio_pipeline topology collapses into one.
#
# TTS stays off. The audio-lock guard would allow it now that the mic is on, but
# a backend speaking every reply only makes an already slow test slower.

[cltl.backend]
audio_storage: remote
image_storage: remote

[cltl.backend.mic]
topic: cltl.topic.microphone
