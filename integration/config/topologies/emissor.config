# Topology: emissor — event stream persisted as an EMISSOR scenario.
#
# flush_interval 0 writes to disk after every event. The default is -1, which
# never flushes at all: scenario.json is written on scenario start and stop
# (EmissorDataFileStorage does that explicitly), but signals accumulate in
# memory and a test asserting on files would see an empty signal list.

[cltl.emissor-data]
flush_interval: 0
