# Topology: backend_image — a camera stream turned into stored image signals.
#
# The image counterpart of backend_vad.config, with one difference that matters:
# the mic is switched on by its topic alone, but the camera needs both. Setting
# `rate` above zero is what makes BackendContainer.camera build an ImageCamera
# at all — at rate 0 it returns the falsy sentinel and BackendService skips its
# image thread at the same threshold. Topic without rate captures nothing; rate
# without topic builds a camera the service never reads.
#
# [cltl.backend] server_image_url comes from $CLTL_IMAGE_URL, which the test
# points at a StubImageServer. See config/tier-inprocess.config.
#
# Like the microphone, the image thread does nothing until a ScenarioStarted
# event arrives ([cltl.backend] scenario_topic), so the test has to open a
# scenario; that gate is part of what this slice covers.

[cltl.backend.image]
topic: cltl.topic.image
rate: 4
