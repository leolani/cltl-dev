# Topology: csplit_audio_server — the far half, with speech recognition.
#
# csplit_server plus cltl-vad and cltl-asr. Neither of them ever receives audio
# on the event bus: they receive an id and a sample range and fetch the samples
# over HTTP from [cltl.backend] storage_url — which, on this half, is the
# server's own storage service. The samples they find there were uploaded by a
# backend in the other stack, over a different network. That round trip is the
# thing this topology exists to exercise.
#
# cltl-vad needs nothing configured: VADContainer builds WebRtcVAD unconditionally
# and ignores [cltl.vad] implementation.

[cltl.eliza]
intentions: eliza

[cltl.emissor-data]
flush_interval: 0

[cltl.asr]
implementation: whisper
