# Topology: audio_pipeline — speech in, an answer out.
#
# The only topology that runs a real recogniser, and therefore tier-2 only:
# every ASR implementation the container can build needs torch, which is why the
# tier-1 vad_asr slice injects a stub instead.
#
# No cltl-context here. The backend gates recording on a scenario and the chat
# UI refuses to render without one, but the BDI handshake is not what this test
# is about, so the test publishes ScenarioStarted itself and Eliza runs
# ungated (base.config leaves [cltl.eliza] intentions empty).
#
# TTS stays off. With the microphone enabled the audio-lock guard would allow it,
# but a backend speaking every reply out loud only slows the test down.

[cltl.backend.mic]
topic: cltl.topic.microphone

[cltl.asr]
implementation: whisper
