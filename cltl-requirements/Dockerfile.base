# syntax = docker/dockerfile:1.2
# Two-stage build for optimal layer caching:
#   apt   — system packages (rarely changes)
#   pypi  — external Python deps (changes with requirements.txt)
#
# cltl.* modules are installed per-component via --build-context leolani=...
# Build: DOCKER_BUILDKIT=1 docker build -t ghcr.io/leolani/cltl-base:latest -f Dockerfile.base .

FROM python:3.10 AS apt

LABEL org.opencontainers.image.source="https://github.com/leolani/cltl-containers"
LABEL org.opencontainers.image.description="Leolani base image"
LABEL org.opencontainers.image.licenses="MIT"

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        less \
        gcc \
        build-essential \
        zlib1g-dev \
        wget \
        unzip \
        cmake \
        gfortran \
        libblas-dev \
        liblapack-dev \
        libopenblas-dev \
        libasound-dev \
        libportaudio2 \
        libportaudiocpp0 \
        portaudio19-dev \
        ffmpeg \
        libsm6 \
        libxext6 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*


FROM apt AS pypi

COPY requirements.txt ./

RUN --mount=type=cache,mode=0755,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install -r requirements.txt && \
    find /usr/local/lib/python3.10 -type d -name __pycache__ -exec rm -rf {} +
