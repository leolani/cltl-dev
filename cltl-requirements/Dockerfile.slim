# syntax = docker/dockerfile:1.2
# Slim base image for client-side components (cltl.combot, cltl.backend, cltl.chat-ui,
# cltl.emissor-data, emissor) that run inside Docker without audio/video capture hardware.
# No PyAudio, portaudio, ML frameworks, or NLP tools.
#
# Build: DOCKER_BUILDKIT=1 docker build -t ghcr.io/leolani/cltl-base-slim:latest -f Dockerfile.slim .

FROM python:3.10-slim AS apt

LABEL org.opencontainers.image.source="https://github.com/leolani/cltl-containers"
LABEL org.opencontainers.image.description="Leolani slim base image (client-side components)"
LABEL org.opencontainers.image.licenses="MIT"

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 \
        ffmpeg \
        libsm6 \
        libxext6 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*


# Deliberately NOT installed, and the reason is worth recording because each is
# a request someone will eventually make of this image (ffmpeg used to be on
# this list; cltl.backend's `remote_type: sound` needs it to turn gTTS MP3 into
# WAV through pydub, and the backend is in every deployment, so it is here):
#
#   portaudio   — PyAudio has no aarch64 wheel, so it needs the headers and a
#                 compiler. Only `cltl.backend.server` and
#                 `cltl.backend.source.pyaudio_source` import it, both inside a
#                 `try`, and both only when `run_server: True` drives a real
#                 device. A container has no device to drive.
#   curl        — the component HEALTHCHECKs probe with `python -c urllib.request`
#                 instead. The interpreter is already here.
#
# Anything added below lands in every image built on this base, so prefer a
# component-level install over growing this list.

FROM apt AS pypi

COPY requirements.slim.txt ./

RUN --mount=type=cache,mode=0755,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install -r requirements.slim.txt && \
    find /usr/local/lib/python3.10 -type d -name __pycache__ -exec rm -rf {} +
